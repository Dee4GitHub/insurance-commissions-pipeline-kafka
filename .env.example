# Copy this file to .env and set a real password.
#   copy .env.example .env          (Windows)
#   cp .env.example .env            (Linux, macOS)
#
# .env is gitignored. This file is not, so never put a real password here.
#
# SQL Server rejects weak passwords at startup with a confusing error, so the
# value needs at least 8 characters, and a mix of upper case, lower case,
# digits and a symbol.

MSSQL_SA_PASSWORD=ChangeMe!Passw0rd
